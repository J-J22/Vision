# Copy this file to .env.local. Never commit .env.local.
# You can also skip this file: plug keys in on Vision's AI parts page (http://localhost:3000/parts),
# where they are stored encrypted. A key saved on that page wins over one here.

# Free keys — add any you have; each one takes part of the work
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=

# Paid, optional: Claude (console.anthropic.com). First choice for the master prompt, council head and architect,
# manager and developers; a last-resort spare everywhere else. Billed per token.
ANTHROPIC_API_KEY=

# Try the build screen without any AI (uses hand-written reference code)
# VISION_FAKE_AGENTS=1
