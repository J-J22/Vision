# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Model names. Run `npm run models` to see what your key can use, then adjust.
GROQ_MODEL_BIG=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
# Comma-separated, one per parliament member (architect, product, security, skeptic).
# Different model families give more varied opinions.
GROQ_PARLIAMENT_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Model per build agent (optional)
# GROQ_MODEL_PLANNER=openai/gpt-oss-20b
# GROQ_MODEL_BACKEND=openai/gpt-oss-120b
# GROQ_MODEL_FRONTEND=qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_MODEL_QA=openai/gpt-oss-20b

# Max model calls running at once
LLM_CONCURRENCY=3
# Groq free tier: 8000 tokens per minute per model. Raise it if your Groq plan allows more.
GROQ_TOKENS_PER_MINUTE=8000

# 1 = build agents return canned output without calling Groq (for UI work)
VISION_FAKE_AGENTS=0
